# Configuration of VERA. Copy to .env and fill in only what you need; .env is never versioned.
# Without any value the demo runs with the mock adapter and the rules interpreter.

# Data adapter: mock (generated fixtures) or dataset (pseudonymized demo subset).
VERA_ADAPTER=mock
# Read-only pseudonymized demo database; used only when VERA_ADAPTER=dataset.
VERA_DEMO_DB=
# Writable state for cases and events; created on first use.
VERA_STATE_DB=

# Interpreter of the opening claim: rules (keyword baseline) or classifier (learned, retrained at start, P42).
# The language model adapters (anthropic, openai_compatible) arrive with plan step P41.
VERA_LLM=rules
LLM_API_KEY=
LLM_MODEL=
# Base URL for openai_compatible providers (OpenAI, DeepSeek, vLLM, Ollama).
LLM_BASE_URL=
# Monthly spending cap for the LLM provider, in USD.
LLM_MAX_SPEND_USD=

# Messages per minute per customer before the API answers 429; default 30.
VERA_MESSAGES_PER_MINUTE=

# Secret used to sign demo session tokens.
SESSION_SECRET=

# Public domain served by the web container.
DOMAIN=
