# Configuration of VERA. Copy to .env and fill in only what you need; .env is never versioned.
# Without any value the demo runs with the mock adapter and the rules interpreter.

# Data adapter: mock (generated fixtures) or dataset (pseudonymized demo subset).
VERA_ADAPTER=mock
# Read-only pseudonymized demo database; used only when VERA_ADAPTER=dataset.
VERA_DEMO_DB=
# Writable state for cases and events; created on first use.
VERA_STATE_DB=

# Interpreter: rules (keyword baseline), classifier (learned, retrained at start, P42) or anthropic (Claude reads
# every message; the classifier answers when it cannot, P41).
VERA_LLM=rules
# Anthropic API key, only for VERA_LLM=anthropic. It lives only in this file and in the server's .env, never in git.
LLM_API_KEY=
# Workspace of the provider (wrkspc_...), required when the key is not scoped to one workspace.
LLM_WORKSPACE_ID=
# Default: claude-haiku-4-5-20251001.
LLM_MODEL=
# Spending cap of this process, in USD (default 15); past it every message goes to the classifier. Set the same cap
# in the provider's console: that one survives restarts.
LLM_MAX_SPEND_USD=

# Messages per minute per customer before the API answers 429; default 30.
VERA_MESSAGES_PER_MINUTE=

# Secret used to sign demo session tokens.
SESSION_SECRET=

# Public domain served by the web container.
DOMAIN=
