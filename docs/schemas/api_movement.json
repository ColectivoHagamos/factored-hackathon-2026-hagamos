{
  "$defs": {
    "ChargeKind": {
      "enum": [
        "purchase",
        "bank_adjustment"
      ],
      "title": "ChargeKind",
      "type": "string"
    },
    "ChargeStatus": {
      "enum": [
        "approved",
        "pending",
        "declined",
        "reversed"
      ],
      "title": "ChargeStatus",
      "type": "string"
    },
    "Currency": {
      "description": "Currencies present in the dataset; Mexico operates in USD only.",
      "enum": [
        "USD",
        "COP",
        "ARS"
      ],
      "title": "Currency",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A movement of the session customer, newest first, so the person testing knows what to dispute.",
  "properties": {
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ChargeKind"
    },
    "merchant": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merchant"
    },
    "city": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "City"
    },
    "country": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
          "type": "string"
        }
      ],
      "title": "Amount"
    },
    "currency": {
      "$ref": "#/$defs/Currency"
    },
    "status": {
      "$ref": "#/$defs/ChargeStatus"
    },
    "card": {
      "anyOf": [
        {
          "pattern": "^•••• \\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Card"
    }
  },
  "required": [
    "occurred_at",
    "kind",
    "amount",
    "currency",
    "status"
  ],
  "title": "Movement",
  "type": "object"
}
