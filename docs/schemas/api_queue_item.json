{
  "$defs": {
    "ClaimType": {
      "enum": [
        "unrecognized_charge",
        "improper_charge",
        "scam_transfer",
        "human_request",
        "out_of_scope"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "DisputeReason": {
      "enum": [
        "fraud",
        "not_received",
        "not_as_described",
        "incorrect_amount",
        "duplicate",
        "cancelled_recurring",
        "bank_charge",
        "recognized_by_customer"
      ],
      "title": "DisputeReason",
      "type": "string"
    },
    "Queue": {
      "enum": [
        "fraud",
        "complaints"
      ],
      "title": "Queue",
      "type": "string"
    },
    "TransferReason": {
      "description": "Why a conversation went to a person without a case handoff; each reason is a rule.",
      "enum": [
        "person_requested",
        "coercion",
        "not_understood",
        "regulator",
        "scam_transfer",
        "tool_failure",
        "turn_limit",
        "lost_card"
      ],
      "title": "TransferReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One conversation waiting for an analyst: a case handoff or a transfer note, for the console.",
  "properties": {
    "kind": {
      "enum": [
        "case",
        "transfer"
      ],
      "title": "Kind",
      "type": "string"
    },
    "reference": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Reference",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "queue": {
      "$ref": "#/$defs/Queue"
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "requires_pt_analyst": {
      "title": "Requires Pt Analyst",
      "type": "boolean"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Trace Id",
      "type": "string"
    },
    "claim_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/DisputeReason"
        },
        {
          "$ref": "#/$defs/TransferReason"
        }
      ],
      "title": "Reason"
    },
    "charge_count": {
      "minimum": 0,
      "title": "Charge Count",
      "type": "integer"
    },
    "pending_action": {
      "anyOf": [
        {
          "enum": [
            "block_card",
            "register_dispute"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Action"
    }
  },
  "required": [
    "kind",
    "reference",
    "created_at",
    "queue",
    "summary",
    "requires_pt_analyst",
    "trace_id",
    "reason",
    "charge_count"
  ],
  "title": "QueueItem",
  "type": "object"
}
