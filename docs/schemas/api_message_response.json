{
  "$defs": {
    "ChargeStatus": {
      "enum": [
        "approved",
        "pending",
        "declined",
        "reversed"
      ],
      "title": "ChargeStatus",
      "type": "string"
    },
    "ChargeSummary": {
      "additionalProperties": false,
      "description": "The charge in question, read from the tools, for the panel beside the conversation.",
      "properties": {
        "merchant": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ChargeStatus"
        },
        "card": {
          "anyOf": [
            {
              "pattern": "^•••• \\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card"
        }
      },
      "required": [
        "amount",
        "currency",
        "occurred_at",
        "status"
      ],
      "title": "ChargeSummary",
      "type": "object"
    },
    "Currency": {
      "description": "Currencies present in the dataset; Mexico operates in USD only.",
      "enum": [
        "USD",
        "COP",
        "ARS"
      ],
      "title": "Currency",
      "type": "string"
    },
    "GlassBoxEntry": {
      "additionalProperties": false,
      "description": "Rule applied in a reply, with its source and, when a verified rule yields one, the deadline.",
      "properties": {
        "rule_id": {
          "pattern": "^((POL|PROH)-\\d{2}|(CO|MX|AR|BR)-R\\d{2})$",
          "title": "Rule Id",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        }
      },
      "required": [
        "rule_id",
        "source"
      ],
      "title": "GlassBoxEntry",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "maximum": 50,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "not_sure",
                "unrecognized_charge",
                "improper_charge",
                "lost_card",
                "scam_transfer",
                "human_request"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        }
      },
      "required": [
        "n",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "PendingConfirmation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "block_card",
            "register_dispute"
          ],
          "title": "Action",
          "type": "string"
        },
        "summary": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "action",
        "summary",
        "expires_at"
      ],
      "title": "PendingConfirmation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reply": {
      "title": "Reply",
      "type": "string"
    },
    "options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Option"
      },
      "title": "Options",
      "type": "array"
    },
    "multiple_choice": {
      "default": false,
      "title": "Multiple Choice",
      "type": "boolean"
    },
    "pending_confirmation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingConfirmation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "glass_box": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GlassBoxEntry"
      },
      "title": "Glass Box",
      "type": "array"
    },
    "stage": {
      "default": "received",
      "enum": [
        "received",
        "analysis",
        "verification",
        "result",
        "resolved"
      ],
      "title": "Stage",
      "type": "string"
    },
    "charge": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChargeSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    }
  },
  "required": [
    "reply"
  ],
  "title": "MessageResponse",
  "type": "object"
}
